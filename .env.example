# ExtenGen Environment Variables

# Node & Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL with pgvector / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/extengen
# Or Supabase connection string:
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase Auth / Direct configuration (optional, for direct Supabase Auth integration)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API Key (for text-embedding-3-small)
# Leave empty or set to 'mock' for local offline testing
OPENAI_API_KEY=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Redis / BullMQ for Async Embedding Queue
# If left empty, ExtenGen runs queue jobs synchronously in-process
REDIS_URL=redis://localhost:6379

# GitHub Integration (Optional, for GitHub ingestion)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Default Org and User for Stdio MCP Mode (Claude Code / single-tenant local agent)
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000002
